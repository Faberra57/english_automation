# --- Telegram (obligatoire) ---
TELEGRAM_BOT_TOKEN=123456789:replace_me
# IDs numériques séparés par des virgules. Le bot ignore tous les autres comptes.
TELEGRAM_ALLOWED_USER_IDS=123456789
# Chat privé qui reçoit les messages planifiés (souvent identique à votre user ID).
TELEGRAM_CHAT_ID=123456789
# Laisser vide pour l'API Telegram hébergée. Pour telegram-bot-api local,
# fournir les préfixes complets, par ex. http://127.0.0.1:8081/bot et .../file/bot.
TELEGRAM_BASE_URL=
TELEGRAM_BASE_FILE_URL=
TELEGRAM_MAX_AUDIO_MB=19
TELEGRAM_ACK_MESSAGE=Bien reçu — je prépare ta correction…

# --- Fuseau et planification ---
TZ=Europe/Paris
MORNING_ENABLED=true
MORNING_TIME=07:30
# mon,tue,wed,thu,fri,sat,sun ou all
MORNING_DAYS=mon,tue,wed,thu,fri,sat,sun
EVENING_ENABLED=true
EVENING_TIME=20:30
EVENING_DAYS=mon,tue,wed,thu,fri,sat,sun
# Réessaie les cartes restées en attente (Anki arrêté, réseau indisponible, etc.).
ANKI_RETRY_ENABLED=true
ANKI_RETRY_TIME=23:00

# --- DeepSeek ---
DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=2500
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=3
# Laisser vide pour ne pas envoyer ces options spécifiques aux modèles de raisonnement.
DEEPSEEK_REASONING_EFFORT=
DEEPSEEK_THINKING_ENABLED=false

# --- Groq / Whisper ---
GROQ_API_KEY=replace_me
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LANGUAGE=en
GROQ_TRANSCRIPTION_PROMPT=English learner speaking practice. Preserve mistakes exactly; do not correct them.
GROQ_TIMEOUT_SECONDS=180
GROQ_MAX_RETRIES=3

# --- Profil pédagogique ---
LEARNER_NAME=Learner
LEARNER_LEVEL=B1
EXPLANATION_LANGUAGE=français
TARGET_LANGUAGE=anglais
LEARNER_INTERESTS=technologie, voyages, entrepreneuriat, vie quotidienne
DAILY_ACTIVITY_MINUTES=5
MAX_ERRORS_PER_SUBMISSION=5
DAILY_CARD_LIMIT=5
CORRECTION_STYLE=encourageant, direct et concis

# --- Mémoire RAG locale ---
RAG_TOP_K=12
RAG_CANDIDATE_LIMIT=300
RAG_HISTORY_DAYS=180
RAG_MAX_CONTEXT_CHARS=10000
RAG_RECENCY_HALF_LIFE_DAYS=30

# --- Persistance ---
DATA_DIR=/app/data
DATABASE_PATH=/app/data/english_teacher.sqlite3
AUDIO_DIR=/app/data/audio
LOG_LEVEL=INFO
# 0 = conservation illimitée. Aucune suppression automatique n'est faite par défaut.
AUDIO_RETENTION_DAYS=0

# --- AnkiConnect ---
# AnkiConnect est une API d'Anki Desktop, pas celle du serveur Anki Sync.
ANKI_ENABLED=true
# Avec network_mode: host sur un serveur Linux :
ANKICONNECT_URL=http://127.0.0.1:8765
ANKICONNECT_API_KEY=
ANKI_TIMEOUT_SECONDS=20
ANKI_DECK=English::AI Teacher
ANKI_MODEL=Basic
ANKI_FRONT_FIELD=Front
ANKI_BACK_FIELD=Back
ANKI_TAGS=english_ai,auto_generated
ANKI_CREATE_DECK=true
ANKI_SYNC_AFTER_PUSH=true
ANKI_DUPLICATE_SCOPE=deck
